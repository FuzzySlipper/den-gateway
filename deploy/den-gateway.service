[Unit]
Description=Den Gateway Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dev/den-gateway/artifacts/publish/DenGateway.Service
ExecStart=/home/dev/den-gateway/artifacts/publish/DenGateway.Service/DenGateway.Service --urls http://127.0.0.1:5300
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DenGateway__Database__Path=/home/dev/den-gateway/data/den-gateway.db
Environment=DenGateway__DenCore__BaseUrl=http://127.0.0.1:5199
Environment=DenGateway__DenCore__UseStub=true
Environment=DenGateway__DenChannels__BaseUrl=http://192.168.1.10:18080
Environment=DenGateway__DenChannels__UseStub=false
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
